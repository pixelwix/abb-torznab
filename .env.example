# Copy to .env on the docker host. All optional.
BIND_ADDR=0.0.0.0              # e.g. your LAN IP, to avoid listening on every interface
ABB_BASE=https://audiobookbay.lu
MAX_RESULTS=10
EDITION_PREFERENCE=produced    # produced | narrated | any
PREFS_TOKEN=                   # long random string; lets your request app set per-book editions
ABB_PROXY=                     # http://host:port proxy for ABB requests (e.g. Gluetun's HTTP proxy) if ABB blocks your IP
ABB_VPN_CONTROL=               # Gluetun control API (http://host:port) of that VPN; lets the bridge switch server when ABB refuses
ABB_VPN_KEY=                   # its control API key
