# Copy to deploy.env (not committed) and fill in. Used by ./deploy.sh.
# Plain docker host over SSH:
DEPLOY_SSH=root@docker-host
DEPLOY_DIR=/opt/abb-torznab
# ...or a Proxmox LXC: set the Proxmox node here and the container id below (DEPLOY_SSH is then the node).
#DEPLOY_PCT=108
# Where the bridge answers after deploy (for the health check):
BRIDGE_URL=http://docker-host:8791
